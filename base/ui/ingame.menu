#include "ui/menudef.h"
{
    menuDef {
        name "ingame"
        rect 100 90 440 300
        visible 0
        style WINDOW_STYLE_FILLED
        backcolor .035 .025 .025 .95
        focusColor 1 .75 .3 1
        onESC { uiScript closeingame }
        itemDef {
            name resume
            type ITEM_TYPE_BUTTON
            text "RESUME"
            rect 40 40 360 30
            textscale .35
            forecolor 1 1 1 1
            visible 1
            action { uiScript closeingame }
        }
        itemDef {
            name settings
            type ITEM_TYPE_BUTTON
            text "SETTINGS"
            rect 40 90 360 30
            textscale .3
            forecolor 1 1 1 1
            visible 1
            action { open ingame_options }
        }
        itemDef {
            name restart
            type ITEM_TYPE_BUTTON
            text "RESTART MAP"
            rect 40 140 360 30
            textscale .3
            forecolor 1 1 1 1
            visible 1
            action { uiScript closeingame ; exec "map_restart" }
        }
        itemDef {
            name leave
            type ITEM_TYPE_BUTTON
            text "MAIN MENU"
            rect 40 190 360 30
            textscale .3
            forecolor 1 1 1 1
            visible 1
            action { uiScript leave }
        }
        itemDef {
            name quit
            type ITEM_TYPE_BUTTON
            text "QUIT"
            rect 40 240 360 30
            textscale .3
            forecolor 1 1 1 1
            visible 1
            action { exec "quit" }
        }
    }
}
