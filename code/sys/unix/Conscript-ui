# ui

Import qw( BASE_CFLAGS CONFIG_DIR BUILD_DIR BASEGAME CC CXX LINK );

$env = new cons(
	CC => $CC,
	CXX => $CXX,
	LINK => $LINK,
  CFLAGS => $BASE_CFLAGS . '-fPIC',
  LDFLAGS => '-shared -ldl -lm'
);

@FILES = qw(
  ../game/bg_misc.cpp
  ../game/q_math.cpp
  ../game/q_shared.cpp
  ../ui/ui_atoms.cpp
  ../ui/ui_gameinfo.cpp
  ../ui/ui_main.cpp
  ../ui/ui_players.cpp
  ../ui/ui_shared.cpp
  ../ui/ui_syscalls.cpp
  ../ui/ui_util.cpp
  );
$FILESREF = \@FILES;
  
# FIXME CPU string  
Program $env 'uii386.so', @$FILESREF;
Install $env '#' . $CONFIG_DIR . '/out/' . $BASEGAME, 'uii386.so';

